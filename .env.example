# ==============================================================================
# FitSense AI - Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual configuration.
# WARNING: NEVER commit .env with real credentials or keys to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security / JWT Authentication
# Generate a secure key using: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Password Hashing (argon2 or bcrypt)
PASSWORD_HASH_SCHEME=argon2

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=fitsense_ai

# CORS Allowed Origins (Comma-separated URLs)
ALLOWED_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1:8000

# Rate Limiting
RATE_LIMIT_AUTH_PER_MINUTE=10

# ------------------------------------------------------------------------------
# Mobile App (Flutter Configuration)
# ------------------------------------------------------------------------------
# For Android emulator pointing to local host: http://10.0.2.2:8000
# For physical device on the same Wi-Fi network: http://<LAN_IP>:8000
# For production: https://api.yourdomain.com
API_BASE_URL=http://10.0.2.2:8000
